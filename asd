<style>
    @import url('https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css');

    .visionaries-section-alt {
        background-color: #f5f0e1; /* Light beige background */
        border-radius: 20px;
        padding: 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: sans-serif;
        color: #4a4a4a; /* Dark text color */
        max-width: 1000px;
        margin: 20px auto;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
    }

    .visionaries-title-alt {
        font-size: 36px;
        font-weight: bold;
        flex-basis: 30%;
        position: relative;
    }

    .visionaries-title-alt::before {
        content: "\201C";
        position: absolute;
        top: -20px;
        left: -20px;
        font-size: 80px;
        color: rgba(0, 0, 0, 0.05);
        transform: rotate(180deg);
    }

    .visionaries-items-alt {
        display: flex;
        justify-content: space-around;
        flex-basis: 70%;
    }

    .visionary-item-alt {
        text-align: center;
        width: 120px;
        perspective: 1000px; /* Add perspective for 3D effect */
    }

    .visionary-icon-alt {
        border-radius: 50%;
        width: 80px;
        height: 80px;
        margin: 0 auto 15px;
        position: relative;
        transition: transform 0.6s;
        transform-style: preserve-3d;
        cursor: pointer;
    }

    .visionary-item-alt:hover .visionary-icon-alt {
        transform: rotateY(180deg);
    }

    .icon-face {
        position: absolute;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        backface-visibility: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .icon-front {
        background-color: #ffffff;
        border: 2px solid #2b5c50;
    }

    .icon-front i {
        color: #2b5c50;
        font-size: 36px;
    }

    .icon-back {
        background-color: #2b5c50; /* The original green color */
        transform: rotateY(180deg);
    }

    .icon-back i {
        color: #ffffff;
        font-size: 36px;
    }

    .visionary-text-alt {
        font-size: 14px;
        line-height: 1.4;
        font-weight: 500;
    }
</style>

<div class="visionaries-section-alt">
    <div class="visionaries-title-alt">
        Tailored solutions for visionaries
    </div>
    <div class="visionaries-items-alt">
        <div class="visionary-item-alt">
            <div class="visionary-icon-alt">
                <div class="icon-face icon-front"><i class="fas fa-lightbulb"></i></div>
                <div class="icon-face icon-back"><i class="fas fa-seedling"></i></div>
            </div>
            <div class="visionary-text-alt">Aspiring Food Entrepreneurs</div>
        </div>
        <div class="visionary-item-alt">
            <div class="visionary-icon-alt">
                <div class="icon-face icon-front"><i class="fas fa-store"></i></div>
                <div class="icon-face icon-back"><i class="fas fa-chart-line"></i></div>
            </div>
            <div class="visionary-text-alt">Emerging Food Startups</div>
        </div>
        <div class="visionary-item-alt">
            <div class="visionary-icon-alt">
                <div class="icon-face icon-front"><i class="fas fa-expand-arrows-alt"></i></div>
                <div class="icon-face icon-back"><i class="fas fa-rocket"></i></div>
            </div>
            <div class="visionary-text-alt">Scaling Up Food Businesses</div>
        </div>
        <div class="visionary-item-alt">
            <div class="visionary-icon-alt">
                <div class="icon-face icon-front"><i class="fas fa-gem"></i></div>
                <div class="icon-face icon-back"><i class="fas fa-crown"></i></div>
            </div>
            <div class="visionary-text-alt">Established Brands</div>
        </div>
    </div>
</div>




























